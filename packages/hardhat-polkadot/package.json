{
  "name": "hardhat-polkadot",
  "version": "0.1.0",
  "description": "Hardhat 3 plugin to compile Solidity to PolkaVM (Polkadot) using the resolc / revive compiler.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ethereum",
    "polkadot",
    "polkavm",
    "resolc",
    "revive",
    "solidity",
    "smart-contracts",
    "hardhat",
    "hardhat3",
    "hardhat-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@parity/resolc": "^1.2.0"
  },
  "peerDependencies": {
    "hardhat": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "hardhat": "^3.4.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
